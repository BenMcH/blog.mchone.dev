---
layout: layout.liquid
authorName: Ben McHone
---

<article class="max-w-4xl mx-auto space-y-4">
  <header class="bg-white rounded-lg p-8 shadow-sm">
    <h1 class="text-4xl md:text-5xl font-bold text-gray-950 leading-tight">{{ title }}</h1>
    <div class="mt-4 flex items-center gap-3 text-gray-600">
      <span class="font-medium text-gray-900">{{ authorName }}</span>
      <span>·</span>
      <time class="font-mono text-sm">{{ date | postDate }}</time>
    </div>
  </header>

  {%- if hero -%}
    <img alt="Hero Image" src="{{hero}}" class="w-full rounded-lg shadow-sm" />
  {%- endif -%}

  <div class="prose prose-lg max-w-none bg-white rounded-lg p-8 shadow-sm">
    {{ content }}
  </div>

  <div class="bg-white rounded-lg p-8 shadow-sm">
    <p class="text-gray-700">
      Like this blog post?
      <a href="https://twitter.com/intent/tweet?text=%22Check out this blog post by @mchonedev that I just read! https://blog.mchone.dev{{page.url}}%22" class="text-blue-600 hover:text-blue-700 font-medium">Share it on X!</a>
    </p>
  </div>

  <!-- Post Feedback Form -->
  <div class="bg-white rounded-lg p-8 shadow-sm">
    <h3 class="text-xl font-semibold text-gray-900 mb-4">Have feedback on this post?</h3>
    <p class="text-gray-600 mb-6">Let me know what you think! I'd love to hear your thoughts, questions, or suggestions.</p>
    
    <form action="https://formspree.io/f/mzdgdrzw" method="POST" class="space-y-4">
      <input type="hidden" name="post_url" value="https://blog.mchone.dev{{page.url}}" />
      <input type="hidden" name="post_title" value="{{ title }}" />
      
      <div>
        <label for="feedback-name" class="block text-sm font-medium text-gray-700 mb-1">
          Name <span class="text-red-500">*</span>
        </label>
        <input
          type="text"
          id="feedback-name"
          name="name"
          required
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent"
          placeholder="Your name"
        />
      </div>

      <div>
        <label for="feedback-email" class="block text-sm font-medium text-gray-700 mb-1">
          Email <span class="text-red-500">*</span>
        </label>
        <input
          type="email"
          id="feedback-email"
          name="email"
          required
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent"
          placeholder="your@email.com"
        />
      </div>

      <div>
        <label for="feedback-message" class="block text-sm font-medium text-gray-700 mb-1">
          Message <span class="text-red-500">*</span>
        </label>
        <textarea
          id="feedback-message"
          name="message"
          required
          rows="5"
          class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-600 focus:border-transparent resize-y"
          placeholder="Your feedback, thoughts, or questions..."
        ></textarea>
      </div>

      <div>
        <button
          type="submit"
          class="w-full sm:w-auto px-6 py-2 bg-blue-600 text-white font-medium rounded-lg hover:bg-blue-700 transition-colors focus:outline-none focus:ring-2 focus:ring-blue-600 focus:ring-offset-2"
        >
          Send Feedback
        </button>
      </div>
    </form>
  </div>
</article>
